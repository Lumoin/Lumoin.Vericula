<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<OutputType>Exe</OutputType>
		<RootNamespace>Lumoin.Vericula.Cli</RootNamespace>
		<AssemblyName>lumoin-vericula</AssemblyName>
		<ImplicitUsings>enable</ImplicitUsings>
		<!-- The CLI is an executable, not a shippable library. Packaging it as a dotnet tool
		     (PackAsTool) is a deferred follow-up; until then it is excluded from pack. -->
		<IsPackable>false</IsPackable>
	</PropertyGroup>

	<ItemGroup>
		<PackageReference Include="Microsoft.Extensions.Hosting" />
		<PackageReference Include="Microsoft.Extensions.DependencyInjection" />
		<PackageReference Include="Microsoft.Extensions.Logging.Console" />
		<PackageReference Include="System.CommandLine" />
		<PackageReference Include="ModelContextProtocol" />
		<PackageReference Include="Spectre.Console" />
	</ItemGroup>

	<ItemGroup>
		<ProjectReference Include="..\Lumoin.Vericula\Lumoin.Vericula.csproj" />
		<ProjectReference Include="..\Lumoin.Vericula.MessageFormat\Lumoin.Vericula.MessageFormat.csproj" />
	</ItemGroup>

</Project>
