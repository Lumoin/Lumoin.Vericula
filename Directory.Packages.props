<Project>

	<PropertyGroup>
		<ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
		<CentralPackageTransitivePinningEnabled>true</CentralPackageTransitivePinningEnabled>
	</PropertyGroup>

	<!--
		Self-contained central package management for the standalone XLIFF family.
		All packages are consumed from nuget.org only.
	-->
	<ItemGroup>
		<!-- Source generator / analyzer tooling. -->
		<PackageVersion Include="Microsoft.CodeAnalysis.CSharp" Version="[4.14.0,6.0)" />
		<PackageVersion Include="Microsoft.CodeAnalysis.Analyzers" Version="[4.14.0,6.0)" />
		<PackageVersion Include="System.Memory" Version="[4.6.3,5.0)" />
		<PackageVersion Include="Microsoft.Bcl.HashCode" Version="[6.0.0,7.0)" />
		<PackageVersion Include="Lumoin.Base" Version="0.0.12" />
		<PackageVersion Include="Lumoin.Veritas.Core" Version="0.0.1" />
		<PackageVersion Include="Lumoin.Veritas.Turtle" Version="0.0.1" />

		<!-- Hosting, configuration and logging for the CLI. -->
		<PackageVersion Include="Microsoft.Extensions.DependencyInjection" Version="[10.0.11,11.0)" />
		<PackageVersion Include="Microsoft.Extensions.Hosting" Version="[10.0.11,11.0)" />
		<PackageVersion Include="Microsoft.Extensions.Logging.Console" Version="[10.0.11,11.0)" />

		<!--
			Command line and MCP surfaces. ModelContextProtocol went 1.x -> 2.x, so the
			upper bound moves with it; the MCP server surface here is still scaffolding
			(Mcp/McpEntryPoint.cs and Mcp/Tools/*) and consumes no MCP API yet, so the
			major bump carries no source impact.
		-->
		<PackageVersion Include="System.CommandLine" Version="[2.0.11,3.0)" />
		<PackageVersion Include="ModelContextProtocol" Version="[2.1.0,3.0)" />

		<!-- Human-facing console output. -->
		<PackageVersion Include="Spectre.Console" Version="[0.57.2,1.0)" />
		<PackageVersion Include="Spectre.Console.Ansi" Version="[0.57.2,1.0)" />
	</ItemGroup>

</Project>
